# ─────────────────────────────────────────────────────────────
#  Simple Ground — konfigurasi. Salin file ini menjadi ".env"
#  lalu isi nilainya. JANGAN commit file .env ke GitHub.
# ─────────────────────────────────────────────────────────────

# Alamat website (tanpa garis miring di akhir).
# Lokal: http://localhost:3000   |   VPS: https://simpleground.online
SITE_URL=http://localhost:3000

# ── Multi-toko (opsional) ────────────────────────────────────
# Toko ditentukan dari domain yang dibuka. Domain yang tidak terdaftar
# (localhost, domain lama) memakai toko bawaan.
# Slug toko bawaan; kosong = toko awal "simple-ground".
DEFAULT_STORE_SLUG=
# Domain platform untuk subdomain toko, mis. platform.id → tokoa.platform.id.
# Kosong = fitur subdomain tidak aktif. Untuk mencoba di lokal: localhost → toko-b.localhost:3000
PLATFORM_ROOT_DOMAIN=

# ── Database PostgreSQL ──────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgres://sgstore:sgstore@localhost:5432/sgstore
# Isi "require" bila database di cloud (Neon, Supabase, dll) mewajibkan SSL.
DATABASE_SSL=
DB_POOL_MAX=10

# ── Kunci enkripsi ───────────────────────────────────────────
# Mengenkripsi kunci API tiap toko (server key Midtrans, API key Biteship) di database.
# Isi dengan minimal 32 karakter acak, mis. hasil: openssl rand -hex 32
# JANGAN diganti setelah dipakai: kunci yang sudah tersimpan tidak bisa dibuka lagi.
APP_ENCRYPTION_KEY=

# ── Admin ────────────────────────────────────────────────────
# Akun admin utama (dibuat otomatis saat login pertama di /admin/login).
# Akun ini adalah admin platform: pemilik toko bawaan dan bisa mengelola semua toko.
# Mengganti ADMIN_PASSWORD di sini juga mengganti password akun tersebut.
ADMIN_EMAIL=admin@simpleground.online
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_NAME=Admin
# (Opsional) Email Google yang otomatis boleh masuk admin toko bawaan, pisahkan dengan koma.
ADMIN_EMAILS=

# ── Login Google (pelanggan & admin) ─────────────────────────
# Client ID dari Google Cloud Console → APIs & Services → Credentials.
# Tambahkan http://localhost:3000 dan domain Anda di "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=288475161498-4t2ksn25uhbgc2vm1f1h9bvsuln5feu0.apps.googleusercontent.com

# ── Penyimpanan foto produk ──────────────────────────────────
# local = disimpan di folder server (paling mudah untuk VPS & lokal)
# s3    = Cloudflare R2 / AWS S3 / MinIO (wajib bila deploy ke Cloudflare)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Hanya untuk STORAGE_DRIVER=s3
# Contoh R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Pembayaran Midtrans ──────────────────────────────────────
# Hanya dipakai toko bawaan (Simple Ground) bila kunci belum diisi di
# Admin → Pengaturan. Toko lain wajib memakai akun Midtrans masing-masing.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = mode Sandbox (uji coba). Kosong/true = Production.
MIDTRANS_IS_PRODUCTION=false

# ── Ongkir Biteship ──────────────────────────────────────────
# Kunci platform; dipakai toko yang belum mengisi kuncinya sendiri di Admin → Pengaturan.
# BITESHIP_ORIGIN_POSTAL_CODE hanya untuk toko bawaan (toko lain mengatur kode pos gudangnya sendiri).
BITESHIP_API_KEY=
# sandbox = pakai tarif simulasi bila API Biteship gagal/kosong (untuk uji coba lokal)
BITESHIP_MODE=sandbox
BITESHIP_ORIGIN_POSTAL_CODE=44163
# (Opsional) Alamat API Biteship; hanya diganti untuk pengujian.
# BITESHIP_API_URL=https://api.biteship.com
