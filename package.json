{
  "name": "sgstore",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test": "node check-bulk.cjs && node check-product-editor.cjs && node check-preorder-checkout.cjs",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@shadcn/react": "0.3.0",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
